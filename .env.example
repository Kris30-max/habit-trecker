# Токен от @BotFather
BOT_TOKEN=
# Telegram ID пользователей с доступом, через запятую
ALLOWED_USER_IDS=
# Supabase → Connect → Session pooler (замените префикс на postgresql+asyncpg://)
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DEFAULT_TZ=Europe/Moscow
TICK_SECONDS=60
LOG_LEVEL=INFO
